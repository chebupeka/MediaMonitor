# HTTPS для стенда: сертификат Let's Encrypt для DOMAIN, прокси на сервер — API, сайт на «/»
# и веб-версия на «/app/» (их раздаёт сам сервер, с кэшем и сжатием).
{$DOMAIN} {
	encode gzip

	# Поток хода поиска (SSE) — без буферизации, иначе события приходят пачкой.
	reverse_proxy api:8000 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
