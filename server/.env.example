# Медиамонитор — настройки сервера.
# Скопируйте в server/.env и заполните. Ключи и пароли — только в .env на сервере,
# в репозиторий и в расширение они не попадают (НТ-15). Пустое значение — «не задано».

# ---------------------------------------------------------------- база (docker compose)
POSTGRES_DB=mediamonitor
POSTGRES_USER=mediamonitor
POSTGRES_PASSWORD=
# Для запуска без контейнера (uv run): postgresql+psycopg://<пользователь>:<пароль>@localhost:5432/<база>
# В docker compose адрес собирается из POSTGRES_* сам.
DATABASE_URL=

# ---------------------------------------------------------------- адреса
# Адрес интерфейса: из него строится ссылка-ключ рабочего места (Р8). На стенде — веб-версия,
# например http://109.196.167.227:8000/app/
PUBLIC_APP_URL=http://localhost:5173/
# Откуда разрешены запросы браузера: сайт и расширение, через запятую. Сайт и веб-версия,
# которые раздаёт этот же сервер, — тот же адрес, их перечислять не нужно.
CORS_ORIGINS=http://localhost:5173
# Сайт-витрина на «/» и веб-версия панели на «/app/» с этого же сервера. В образе Docker
# заданы (Dockerfile: /app/static/site и /app/static/app); пусто — только API.
SITE_DIR=
WEB_APP_DIR=
# Домен для HTTPS (профиль https в compose, Caddy).
DOMAIN=

# ---------------------------------------------------------------- данные площадок
# fixtures — записанные примеры (разработка); live — настоящие VK, OK, MAX.
DATA_SOURCE=fixtures
# Своя настройка для одной площадки — важнее DATA_SOURCE; пусто — как DATA_SOURCE.
# Например, VK вживую, OK и MAX на примерах: DATA_SOURCE=fixtures, DATA_SOURCE_VK=live.
# Публикации площадок на примерах помечаются «демо-публикация, ссылки нет».
DATA_SOURCE_VK=
DATA_SOURCE_OK=
DATA_SOURCE_MAX=
# Сбои записанных примеров: vk|ok|max : unavailable|bad-response|rate-limited|slow|timeout|quota|key-invalid
FIXTURE_FAILURES=
FIXTURE_STEP_DELAY_MS=120
FIXTURE_SHIFT_TO_NOW=false
# Сервисный ключ своего приложения VK ID (только сервер).
VK_SERVICE_TOKEN=
# VK вживую (adapters/vk_live.py): адрес API, запросов в секунду на ключ, тайм-аут, сколько минут
# повторный поиск берёт стену сообщества из кэша, потолок страниц по 100 постов на сообщество.
VK_API_URL=https://api.vk.com/method
VK_REQUESTS_PER_SECOND=3
VK_TIMEOUT_SEC=15
VK_CACHE_MINUTES=30
VK_MAX_PAGES_PER_SOURCE=10
# Бюджет вызовов открытого стенда (НТ-6): предел на сутки и на месяц по Красноярску, 0 — без
# предела. Исчерпан — у площадки «нет доступа: лимит на сегодня исчерпан», на 80% —
# предупреждение дежурному в журнале стенда.
VK_DAILY_CALLS=1500
VK_MONTHLY_QUOTA=10000
# Ключ MaxStat (поиск по MAX, adapters/max_live.py; включение — DATA_SOURCE или DATA_SOURCE_MAX выше).
# Кредиты: поиск — 3, пост — 1. Запасное имя — MAXSTAT_TOKEN.
MAXSTAT_API_TOKEN=
MAXSTAT_TOKEN=
# На один поиск: страниц выдачи по 3 кредита и запросов «канал по id» по 1 кредиту; кэш, мин.
MAXSTAT_MAX_PAGES=3
MAXSTAT_CHANNEL_LOOKUPS=5
MAXSTAT_CACHE_MINUTES=60
MAXSTAT_DAILY_CREDITS=150
MAXSTAT_CREDITS=1000
PLATFORM_TIMEOUT_SEC=90

# ---------------------------------------------------------------- сайты СМИ и Дзен (дополнительные площадки)
# Каталог — src/mediamonitor/data/krai-media.json (43 сайта и 25 каналов редакций края).
# live — читать в момент поиска (стенд в РФ: из-за рубежа сайты края не открываются);
# fixtures — записанные образцы ответов (разработка); off — выключить площадку.
# От DATA_SOURCE не зависят. Дзен — серая зона правил, как OK: выключается DZEN_SOURCE=off.
SITES_SOURCE=live
DZEN_SOURCE=live
# Вежливость: не чаще 1 запроса в N секунд на сайт, не больше 4 сразу к одному серверу
# (42 сайта стоят на одном), тайм-аут запроса, кэш ответов лент и каналов (Р7: экономия).
SOURCES_MIN_INTERVAL_SEC=1
SOURCES_PER_IP=4
SOURCES_REQUEST_TIMEOUT_SEC=10
SOURCES_CACHE_SEC=600
# Пусто — «Mediaradar/<версия> (prototype media monitor for Krasnoyarsk Krai news; +<адрес стенда>)».
SOURCES_USER_AGENT=
# Срок на площадку и «бюджет» страниц на один поиск.
SITES_DEADLINE_SEC=50
SITES_ARTICLES_PER_SITE=4
SITES_MAX_ARTICLES=40
DZEN_DEADLINE_SEC=60
DZEN_MAX_PAGES=3

# ---------------------------------------------------------------- нейросеть (Ollama на другом компьютере)
# Например http://10.0.0.5:11434. Не задан — «смысловая проверка недоступна».
OLLAMA_URL=
# Модель в Ollama (можно задать и как OLLAMA_MODEL). Q6_K — см. gpu-node/README.md.
LLM_MODEL=hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q6_K
LLM_MODEL_LABEL=GigaChat 3.1 Lightning, локально (Ollama)
# Ключ, если провайдер его требует (OpenAI-совместимый API). Для Ollama не нужен.
LLM_API_KEY=
LLM_TIMEOUT_SEC=60
# Запросов к нейросети одновременно: Ollama отвечает параллельно (4 — в 1,45 раза быстрее).
LLM_CONCURRENCY=4
LLM_BATCH_SIZE=8
LLM_WARMUP=true

# Как воронка зовёт нейросеть: ollama (/api/chat) или openai (/v1/chat/completions).
LLM_API=ollama
# Бюджет нейросети на один поиск: сколько спорных и сколько секунд всего (НТ-6).
# Проверяются самые близкие к запросу, ~0,55 с на решение.
LLM_MAX_GRAY=150
LLM_DEADLINE_SEC=150
# Контекст запросов = OLLAMA_CONTEXT_LENGTH на компьютере с Ollama: модель не перезагружается.
LLM_NUM_CTX=8192
# Сколько Ollama держит модель после запроса: -1 — всегда (после простоя поиск не ждёт загрузку).
# Число — секунды, строка с единицей — длительность (30m). Значение уходит в каждый запрос.
OLLAMA_KEEP_ALIVE=-1

# ---------------------------------------------------------------- отбор (воронка «Э-Отбор»)
# Воронка «модуль:функция». Без моделей (заглушка) — mediamonitor.matcher.simple:create_matcher.
MATCHER=mediamonitor.matcher.funnel:create_matcher
# Сколько постов отбирается за шаг: после каждого шага результаты уходят в поток.
MATCH_BATCH_SIZE=16
MATCHER_WARMUP=true

# ---------------------------------------------------------------- модель смысла (эмбеддинги)
EMBEDDING_MODEL=sergeyzh/BERTA
# Версия векторов в кэше базы: поменяйте — посты посчитаются заново.
EMBEDDING_VERSION=1
# Сервис на компьютере с видеокартой (gpu-node). Пусто — модель на CPU этого сервера.
EMBEDDINGS_URL=
EMBEDDINGS_TOKEN=
EMBEDDINGS_TIMEOUT_SEC=30
EMBEDDINGS_BATCH_SIZE=256
# Сервис упал — столько секунд считаем на CPU, потом пробуем сервис снова.
EMBEDDINGS_RETRY_AFTER_SEC=60
# false — без отката на CPU (слабый сервер, образ LOCAL_MODEL=false, compose.server.yaml):
# сервис недоступен — отбор по словам и признакам события, на стенде предупреждение.
EMBEDDINGS_CPU_FALLBACK=true

# ---------------------------------------------------------------- проверка текста на ИИ
# auto: задан AI_DETECT_URL — сервис детектора (GigaCheck) на компьютере с видеокартой;
# не задан — выключено («проверка недоступна» и предупреждение на стенде), кроме разработки
# на записанных примерах (ENVIRONMENT=development): там демо-оценка из хеша текста.
# Явно: gigacheck | fixture (демо без модели — не для живых текстов) | off.
AI_DETECT_PROVIDER=auto
# Сервис детектора (gpu-node), токен — тот же EMBEDDINGS_TOKEN. Через SSH-туннель:
# http://127.0.0.1:8090 — детектор в процессе сервиса эмбеддингов;
# http://127.0.0.1:8091 — отдельный сервис детектора (третий порт туннеля).
AI_DETECT_URL=
# Модель, которую ждём от сервиса; другая — «проверка недоступна».
AI_DETECT_MODEL=iitolstykh/GigaCheck-Classifier-Multi
AI_DETECT_TIMEOUT_SEC=60
AI_DETECT_BATCH_SIZE=16
AI_DETECT_CONCURRENCY=1
# Сервис упал — столько секунд отвечаем «недоступно» без вызова, потом пробуем снова.
AI_DETECT_RETRY_AFTER_SEC=60
# Сколько итог поиска ждёт фоновую проверку постов; остальное досчитается после.
AI_DETECT_FINISH_WAIT_SEC=20
# Пороги уровней по оценке модели (0…1) и минимум слов — одни для всех мест.
AI_CHECK_LIKELY_THRESHOLD=0.85
AI_CHECK_SIGNS_THRESHOLD=0.60
AI_CHECK_MIN_WORDS=40
AI_CHECK_RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------- лимиты стенда (НТ-6)
MAX_QUERY_LENGTH=20000
MAX_PERIOD_DAYS=183
ACTIVE_SEARCHES_PER_WORKSPACE=1
MAX_RUNNING_SEARCHES=4
RATE_LIMIT_PER_MINUTE=240
SEARCH_RATE_LIMIT_PER_MINUTE=12
WORKSPACE_RATE_LIMIT_PER_MINUTE=20
# Новых рабочих мест с одного IP за сутки (в базе — только хеш адреса).
WORKSPACES_PER_IP_PER_DAY=60
QUOTA_WARN_RATIO=0.8

# ---------------------------------------------------------------- служебное
ENVIRONMENT=production
LOG_LEVEL=INFO
