# Медиамонитор — настройки сервера.
# Скопируйте в server/.env и заполните. Ключи и пароли — только в .env на сервере,
# в репозиторий и в расширение они не попадают (НТ-15). Пустое значение — «не задано».

# ---------------------------------------------------------------- база (docker compose)
POSTGRES_DB=mediamonitor
POSTGRES_USER=mediamonitor
POSTGRES_PASSWORD=
# Для запуска без контейнера (uv run): postgresql+psycopg://<пользователь>:<пароль>@localhost:5432/<база>
# В docker compose адрес собирается из POSTGRES_* сам.
DATABASE_URL=

# ---------------------------------------------------------------- адреса
# Адрес интерфейса: из него строится ссылка-ключ рабочего места (Р8).
PUBLIC_APP_URL=http://localhost:5173/
# Откуда разрешены запросы браузера: сайт и расширение, через запятую.
CORS_ORIGINS=http://localhost:5173
# Домен для HTTPS (профиль https в compose, Caddy).
DOMAIN=

# ---------------------------------------------------------------- данные площадок
# fixtures — записанные примеры (разработка); live — настоящие VK, OK, MAX.
DATA_SOURCE=fixtures
# Сбои записанных примеров: vk|ok|max : unavailable|bad-response|rate-limited|slow|timeout|quota|key-invalid
FIXTURE_FAILURES=
FIXTURE_STEP_DELAY_MS=120
FIXTURE_SHIFT_TO_NOW=false
# Сервисный ключ своего приложения VK ID (только сервер).
VK_SERVICE_TOKEN=
VK_MONTHLY_QUOTA=10000
# Ключ MaxStat (поиск по MAX).
MAXSTAT_TOKEN=
MAXSTAT_CREDITS=1000
PLATFORM_TIMEOUT_SEC=90

# ---------------------------------------------------------------- нейросеть (Ollama на другом компьютере)
# Например http://10.0.0.5:11434. Не задан — «смысловая проверка недоступна».
OLLAMA_URL=
# Модель в Ollama (можно задать и как OLLAMA_MODEL). Q6_K — см. gpu-node/README.md.
LLM_MODEL=hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q6_K
LLM_MODEL_LABEL=GigaChat 3.1 Lightning, локально (Ollama)
# Ключ, если провайдер его требует (OpenAI-совместимый API). Для Ollama не нужен.
LLM_API_KEY=
LLM_TIMEOUT_SEC=60
LLM_CONCURRENCY=1
LLM_BATCH_SIZE=8
LLM_WARMUP=true

# Как воронка зовёт нейросеть: ollama (/api/chat) или openai (/v1/chat/completions).
LLM_API=ollama
# Бюджет нейросети на один поиск: сколько спорных и сколько секунд всего (НТ-6).
LLM_MAX_GRAY=60
LLM_DEADLINE_SEC=300
# Контекст запросов = OLLAMA_CONTEXT_LENGTH на компьютере с Ollama: модель не перезагружается.
LLM_NUM_CTX=8192

# ---------------------------------------------------------------- отбор (воронка «Э-Отбор»)
# Воронка «модуль:функция». Без моделей (заглушка) — mediamonitor.matcher.simple:create_matcher.
MATCHER=mediamonitor.matcher.funnel:create_matcher
# Сколько постов отбирается за шаг: после каждого шага результаты уходят в поток.
MATCH_BATCH_SIZE=16
MATCHER_WARMUP=true

# ---------------------------------------------------------------- модель смысла (эмбеддинги)
EMBEDDING_MODEL=sergeyzh/BERTA
# Версия векторов в кэше базы: поменяйте — посты посчитаются заново.
EMBEDDING_VERSION=1
# Сервис на компьютере с видеокартой (gpu-node). Пусто — модель на CPU этого сервера.
EMBEDDINGS_URL=
EMBEDDINGS_TOKEN=
EMBEDDINGS_TIMEOUT_SEC=30
EMBEDDINGS_BATCH_SIZE=256
# Сервис упал — столько секунд считаем на CPU, потом пробуем сервис снова.
EMBEDDINGS_RETRY_AFTER_SEC=60

# ---------------------------------------------------------------- лимиты стенда (НТ-6)
MAX_QUERY_LENGTH=20000
MAX_PERIOD_DAYS=183
ACTIVE_SEARCHES_PER_WORKSPACE=1
MAX_RUNNING_SEARCHES=4
RATE_LIMIT_PER_MINUTE=240
SEARCH_RATE_LIMIT_PER_MINUTE=12
WORKSPACE_RATE_LIMIT_PER_MINUTE=20
QUOTA_WARN_RATIO=0.8

# ---------------------------------------------------------------- служебное
ENVIRONMENT=production
LOG_LEVEL=INFO
