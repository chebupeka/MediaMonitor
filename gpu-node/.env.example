# Компьютер с видеокартой: сервис эмбеддингов (и прокси перед Ollama, если он нужен).
# Скопируйте в .env и заполните. Пустое значение = значение по умолчанию (указано в комментарии).
# Файл .env не попадает в git.

# Токен доступа к сервису эмбеддингов: длинная случайная строка, не короче 16 знаков.
# Тот же токен прописывается на сервере в EMBEDDINGS_TOKEN.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# (windows\start.ps1 создаёт .env и токен сам, если файла нет.)
EMBEDDINGS_TOKEN=

# Порт и адрес сервиса. По умолчанию 8090 и 0.0.0.0 (все сетевые интерфейсы).
EMBEDDINGS_PORT=
EMBEDDINGS_HOST=

# Модель (по умолчанию sergeyzh/BERTA). Менять только вместе с моделью на сервере.
EMBEDDINGS_MODEL=

# Устройство: auto (по умолчанию: видеокарта, если доступна), cuda (только видеокарта — иначе
# сервис не стартует) или cpu.
EMBEDDINGS_DEVICE=

# Сколько текстов модель считает за один проход (по умолчанию 64) и fp16 на видеокарте
# (по умолчанию true).
EMBEDDINGS_BATCH_SIZE=
EMBEDDINGS_FP16=

# Папка для модели с Hugging Face (по умолчанию — кеш пользователя, ~0,5 ГБ).
HF_HOME=

# Только если перед Ollama стоит прокси с токеном (proxy/Caddyfile). Тот же токен — на сервере
# в LLM_API_KEY.
OLLAMA_PROXY_TOKEN=
